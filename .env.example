# Server
PORT=8787
NODE_ENV=development
APP_BASE_URL=http://localhost:8787
FRONTEND_URL=http://localhost:5173
# 32-byte hex key (64 hex chars) for AES-256-GCM encryption of Zendesk OAuth tokens & webhook secrets
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Session JWT HMAC secret for short-lived ZAF iframe API sessions
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Database (leave DATABASE_URL blank to use local SQLite at SQLITE_PATH)
SQLITE_PATH=./data/rubriccheck.sqlite
# DATABASE_URL=postgres://user:pass@host:5432/rubriccheck

# Google Gemini Decisions API (MUST be Paid Tier API key in production for zero-training compliance)
GEMINI_API_KEY=
GEMINI_DECISION_MODEL=gemini-decision-1
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_ALLOW_FALLBACK=true

# Zendesk Global OAuth (dev identifier MUST start with zdg-)
ZENDESK_APP_ID=
ZENDESK_OAUTH_CLIENT_ID=zdg-rubriccheck-qa
ZENDESK_OAUTH_CLIENT_SECRET=
ZENDESK_OAUTH_SCOPES=tickets:read tickets:write webhooks:read webhooks:write
# Optional dev-only bypass for local sidebar testing without signedUrls JWT
ZENDESK_DEV_MODE=false

# Paddle Billing (SANDBOX ONLY during development/QA!)
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_STARTER_MONTHLY=
PADDLE_PRICE_STARTER_ANNUAL=
PADDLE_PRICE_GROWTH_MONTHLY=
PADDLE_PRICE_GROWTH_ANNUAL=
PADDLE_PRICE_SCALE_MONTHLY=
PADDLE_PRICE_SCALE_ANNUAL=
